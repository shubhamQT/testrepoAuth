{
  "id": "create-lead-missing-company",
  "testPlanId": "f5ee2691-0de3-4e3e-9652-fc8e95c2324c",
  "requirementId": "2e1823b1-ac4c-4d14-b4e1-7cae6b2033df",
  "suiteName": "Create Lead - E2E",
  "case": {
    "id": "create-lead-missing-company",
    "title": "Attempt to create Lead with missing Company and verify validation error",
    "priority": "P0",
    "platforms": [
      "chrome"
    ],
    "preconditions": [],
    "steps": [
      {
        "id": "step-1",
        "action": "openUrl",
        "targetDescription": "Navigate to Leads tab",
        "value": "https://orgfarm-cdb7bbd1fc-dev-ed.develop.my.salesforce.com/lightning/o/Lead/list"
      },
      {
        "id": "step-2",
        "action": "tap",
        "targetDescription": "Click on 'New' button",
        "locatorHint": "button[title='New']"
      },
      {
        "id": "step-3",
        "action": "fill",
        "targetDescription": "Enter First Name",
        "locatorHint": "input[name='FirstName']",
        "value": "John"
      },
      {
        "id": "step-4",
        "action": "fill",
        "targetDescription": "Enter Last Name",
        "locatorHint": "input[name='LastName']",
        "value": "Smith"
      },
      {
        "id": "step-5",
        "action": "tap",
        "targetDescription": "Click on 'Save' button",
        "locatorHint": "button[title='Save']"
      },
      {
        "id": "step-6",
        "action": "assertVisible",
        "targetDescription": "Verify validation error for Company",
        "locatorHint": "div[role='alert']"
      },
      {
        "id": "step-7",
        "action": "assertContainsText",
        "targetDescription": "Check error message mentions Company",
        "locatorHint": "div[role='alert']",
        "assertion": "Company"
      }
    ],
    "tags": [
      "@e2e",
      "@regression",
      "lead"
    ]
  }
}
